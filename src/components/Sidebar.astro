---
import NavigationTree from './NavigationTree.astro';
import { ROUTES } from '../lib/routes.ts';
import { url } from '../lib/url.ts';
import SearchBar from './sidebar/SearchBar.astro';
import WorkspaceCard from './sidebar/WorkspaceCard.astro';

interface Props { currentPath: string; }
const { currentPath } = Astro.props;
---

<div class="axf-sidebar-inner">
  <div class="axf-sidebar-brand">
    <a class="axf-sidebar-logo" href={url(ROUTES.home.path)} aria-label="AXIORA Workspace Home">
      <span class="axf-wordmark-mark" aria-hidden="true">A</span>
      <span><strong>AXIORA</strong><small>Intelligence Console</small></span>
    </a>
    <button
      class="axf-sidebar-toggle axf-touch-target"
      type="button"
      aria-controls="axf-sidebar"
      aria-expanded="true"
      aria-label="Ciutkan sidebar"
      title="Ciutkan sidebar"
      data-sidebar-toggle
    >
      <span aria-hidden="true">&#9776;</span>
      <span class="axf-visually-hidden" data-sidebar-toggle-label>Ciutkan sidebar</span>
    </button>
  </div>

  <div class="axf-sidebar-search-region"><SearchBar /></div>
  <NavigationTree currentPath={currentPath} />
  <div class="axf-sidebar-footer">
    <WorkspaceCard currentPath={currentPath} />
  </div>
</div>
